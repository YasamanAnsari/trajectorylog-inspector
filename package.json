{
  "name": "trajectorylog-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-side inspector and QA analysis for Varian trajectory log (.bin) files. Files never leave the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:no-network": "node scripts/check-no-network.mjs",
    "deploy": "sh scripts/deploy-pages.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
